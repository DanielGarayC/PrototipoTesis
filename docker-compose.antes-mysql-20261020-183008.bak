services:
  nifi:
    image: apache/nifi:2.7.2
    container_name: nifi_tesis
    ports:
      - "8443:8443"
    environment:
      - SINGLE_USER_CREDENTIALS_USERNAME=admin
      - SINGLE_USER_CREDENTIALS_PASSWORD=NiFiPassword123
    volumes:
      # Aquí NiFi guarda su configuración y el diseño de los Process Groups
      - ./nifi-conf:/opt/nifi/nifi-current/conf
      # Carpetas de datos: staging, convertidos, cuarentena, por proyecto
      - ./data:/data
      # Scripts propios
      - ./scripts:/opt/scripts
    restart: unless-stopped